# Local backend configuration. Replace placeholders for your own environment.
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL and Redis
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/media_saver
REDIS_URL=redis://127.0.0.1:6379

# Authentication (use long, private values outside local development)
JWT_SECRET=replace_with_a_private_access_token_secret
REFRESH_TOKEN_SECRET=replace_with_a_private_refresh_token_secret

# Email used by password reset flows
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_app_password

# Cloudinary credentials are only needed by the legacy upload route
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Cloudflare R2
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET_NAME=media-saver
R2_PUBLIC_DOMAIN=your_public_domain

# Optional error reporting
# SENTRY_DSN=

# Local Docker Compose defaults. Change these before exposing the stack.
POSTGRES_DB=media_saver
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# JWT secrets: use long random values outside local development.
JWT_SECRET=local-dev-change-this-jwt-secret
REFRESH_TOKEN_SECRET=local-dev-change-this-refresh-secret

# App URLs
CLIENT_URL=http://localhost:8080
FRONTEND_PORT=8080

# Required to use media uploads/downloads. The placeholders let the API start,
# but real Cloudflare R2 credentials and bucket details are needed for storage.
R2_ACCOUNT_ID=local-placeholder
R2_ACCESS_KEY_ID=local-placeholder
R2_SECRET_ACCESS_KEY=local-placeholder
R2_BUCKET_NAME=media-saver
R2_PUBLIC_DOMAIN=

# Optional integrations
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GMAIL_USER=
GMAIL_APP_PASSWORD=
SENTRY_DSN=

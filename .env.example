# mediaSaver – Docker Compose environment configuration
#
# Copy this file to .env and fill in real values before starting the stack.
# Never commit .env to version control.
# Production secrets must be stored in the deployment platform (e.g. GitHub
# Actions environment secrets) and injected at deploy time.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=media_saver
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Connection string used by the backend and the migrate service.
# Inside Docker Compose the host must be "postgres" (the service name).
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/media_saver

# ── JWT secrets ───────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
REFRESH_TOKEN_SECRET=replace_with_a_different_long_random_secret

# ── Application URLs ─────────────────────────────────────────────────────────
# CLIENT_URL is returned in CORS headers and used by the backend; set it to the
# URL where the frontend is publicly reachable.
CLIENT_URL=http://localhost:8080

# Port on the host that forwards to the frontend container (default: 8080).
FRONTEND_PORT=8080

# ── Cloudflare R2 ─────────────────────────────────────────────────────────────
# Required for media uploads and downloads.  The stack starts with placeholder
# values but upload/download operations will fail until real credentials are set.
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=media-saver
# Public domain for the bucket (e.g. https://pub-xxxx.r2.dev).  Leave empty if
# the bucket is private and all URLs are pre-signed.
R2_PUBLIC_DOMAIN=

# ── Cloudinary (legacy – optional) ───────────────────────────────────────────
# Only needed if you have media records stored in Cloudinary from an earlier
# version of the app.  New uploads go to R2.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email (password reset) ────────────────────────────────────────────────────
# A Gmail address with an App Password (2-FA must be enabled on the account).
# Leave blank to disable password-reset emails.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ── Error reporting (optional) ────────────────────────────────────────────────
# SENTRY_DSN=
